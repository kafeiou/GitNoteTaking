    <!-- Permission strings -->
    <string name="permission_camera_title">Camera Permission Required</string>
    <string name="permission_camera_rationale">To allow you to take photos directly and save them as note attachments, GIT Note Taking requires access to your camera.\n\nWe only use the camera when you tap the photo button, and never capture images in the background.</string>
    <string name="permission_media_title">Media &amp; File Access Required</string>
    <string name="permission_media_rationale">To allow you to select photos, videos, or audio files and import them as note attachments, GIT Note Taking requires access to your media files.\n\nWe only read the files you choose, and never access unrelated personal data.</string>
    <string name="permission_camera_denied_msg">Camera permission is required to take photos. Please tap \"Re-authorize\" to grant permission.</string>
    <string name="permission_media_denied_msg">Media access permission is required to attach files. Please tap \"Re-authorize\" to grant permission.</string>
    <string name="permission_camera_settings_msg">Camera permission was permanently denied.\n\nTo use this feature, please tap \"Settings\" and enable Camera permission in App Settings.</string>
