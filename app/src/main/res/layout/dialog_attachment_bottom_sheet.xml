<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/drag_handle_color" />

    <!-- File Header: Icon + File Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAttachIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:src="@drawable/unknown24" />

        <TextView
            android:id="@+id/tvAttachFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@color/card_stroke" />

    <!-- File Metadata: Size, Type, Modified Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAttachSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tvAttachType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tvAttachModified"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- 1. Open File Button -->
        <Button
            android:id="@+id/btnOpenAttachment"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/attach_sheet_open"
            android:textSize="14sp" />

        <!-- 2. Save to Downloads Button -->
        <Button
            android:id="@+id/btnDownloadAttachment"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/attach_sheet_download"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/card_stroke"
            android:textSize="14sp" />

        <!-- 3. Delete Attachment Button -->
        <Button
            android:id="@+id/btnDeleteAttachment"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="@string/attach_sheet_delete"
            android:textColor="#D32F2F"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
